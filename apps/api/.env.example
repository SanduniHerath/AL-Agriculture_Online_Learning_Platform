# ============================================================================
# apps/api environment - copy to apps/api/.env and fill in real values.
# NEVER commit .env. Only this .env.example (with placeholders) is committed.
# Variables marked (Phase N) are read from that phase onwards.
# ============================================================================

# ---- Core ----
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
# Allowed browser origin for CORS (the Next.js app)
WEB_URL=http://localhost:3000
LOG_LEVEL=debug
TZ=Asia/Colombo

# ---- Database (Phase 2) ----
# Matches the docker-compose defaults in the root .env.example
DATABASE_URL=mysql://al_agri:al_agri@localhost:3306/al_agri

# ---- Auth & sessions (Phase 3) ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
DEFAULT_DEVICE_LIMIT=2

# ---- Admin seed user (Phase 2 seed script) ----
ADMIN_FULL_NAME=Teacher Admin
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=+94770000000
ADMIN_PASSWORD=change-me-strong-password

# ---- Payments: PayHere (Phase 6) ----
PAYMENT_PROVIDER=payhere
PAYHERE_MERCHANT_ID=replace-me
PAYHERE_MERCHANT_SECRET=replace-me
PAYHERE_SANDBOX=true
# Must be a public HTTPS URL in production; use a tunnel (e.g. ngrok) in development.
PAYHERE_NOTIFY_URL=http://localhost:4000/api/payments/payhere/notify

# ---- Video: mock (dev) or bunny (Phase 7) ----
VIDEO_PROVIDER=mock
BUNNY_STREAM_LIBRARY_ID=replace-me
BUNNY_STREAM_API_KEY=replace-me
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=replace-me
VIDEO_URL_TTL_SECONDS=7200

# ---- File storage: local (dev) or s3 (Phase 5) ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_PUBLIC=al-agri-public
S3_BUCKET_PRIVATE=al-agri-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
PUBLIC_CDN_URL=https://cdn.example.com
SIGNED_URL_TTL_SECONDS=900

# ---- SMS: console (dev) or a Sri Lankan gateway (Phase 3) ----
SMS_PROVIDER=console
SMS_API_KEY=replace-me
SMS_SENDER_ID=ALAGRI

# ---- Email: console (dev) or smtp (Phase 6) ----
EMAIL_PROVIDER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
EMAIL_FROM="A/L Agriculture <no-reply@example.com>"
