# apps/web environment - copy to apps/web/.env.local and adjust. Never commit .env.local.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets in them.

# Public URL of this site (used for SEO metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# API base URL as seen from the Next.js server (server components / route handlers).
# Same as above locally; in production this can be an internal/private hostname.
API_INTERNAL_URL=http://localhost:4000

# Default UI language (si | en). Tamil (ta) planned.
NEXT_PUBLIC_DEFAULT_LOCALE=si

# WhatsApp contact number shown on the home page (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=94770000000
