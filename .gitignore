# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.pnpm-store/

# ---- Build output ----
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ---- Tests & coverage ----
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ---- Environment & secrets (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---- Uploaded / generated content (NEVER commit) ----
uploads/
apps/api/storage/
*.mp4
*.mov
*.mkv
*.sql
*.sql.gz
*.dump
# ...except Prisma migrations, which MUST be committed (they create the tables).
!apps/api/prisma/migrations/**/migration.sql

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---- Prisma ----
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ---- Caches ----
.cache/
.eslintcache
.turbo/
.swc/
.vercel/

# ---- Generated by `next dev` (hints for AI coding tools) ----
apps/web/AGENTS.md

# ---- Prisma generated client (re-created by `prisma generate` on install) ----
apps/api/src/generated/
